{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "dev:worker": "wrangler dev --config ../../wrangler.toml",
    "build": "node ./build.mjs",
    "build:worker": "pnpm --filter @workspace/soundwave run build && wrangler deploy --dry-run --config ../../wrangler.toml",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "deploy:worker": "pnpm --filter @workspace/soundwave run build && wrangler deploy --config ../../wrangler.toml",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "^4.10.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "wrangler": "^4.38.0"
  }
}
